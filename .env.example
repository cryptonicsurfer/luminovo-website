# fal.ai — bildgenerering (Seedream v5 lite). Nyckeln används bara server-side.
FAL_API_KEY=
# TensorX — byggagenten (EU-hostad). Bara server-side.
TENSORX_API_KEY=
# TENSORX_BASE_URL=https://api.tensorx.ai/v1
# TENSORX_MODEL=z-ai/glm-5.3-flash
# TENSORX_MAX_OUTPUT_TOKENS=   # default: modellens kontext − 64k (glm 984k, qwen 198k). Reasoning räknas som output.
# Var build123d-tests ligger (tools/build.py körs därifrån med uv)
# BUILD123D_DIR=../build123d-tests
# Gemini används fortfarande av /api/estimate-price
GEMINI_API_KEY=
# TENSORX_REASONING_EFFORT=medium   # valfritt: kortar modellens tänkande (low/medium/high)
